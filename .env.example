# ==========================================
# IT Helpdesk - Contoh Konfigurasi Environment
# ==========================================
# Salin file ini ke `.env` lalu isi nilai sesuai environment Anda.
# Untuk Docker Compose, cukup ekspor variabel ini di shell atau pakai file `.env`
# di root project (otomatis dibaca oleh docker-compose.yml).

# ----- Database -----
# Saat menjalankan via docker-compose, host = nama service database (lihat docker-compose.yml).
DB_HOST=db
DB_NAME=it_helpdesk
DB_USER=helpdesk_user
DB_PASS=ubah_password_ini

# Password root MySQL (hanya dipakai container database saat init)
MYSQL_ROOT_PASSWORD=ubah_root_password_ini

# ----- Aplikasi -----
APP_NAME="IT Helpdesk"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# ----- Keamanan / Rate Limiting -----
# Maksimal percobaan login gagal sebelum diblokir sementara (per username + IP)
LOGIN_MAX_ATTEMPTS=5
# Durasi blokir dalam detik (default 15 menit)
LOGIN_LOCKOUT_SECONDS=900

# ----- Google OAuth (opsional) -----
# Kosongkan jika tidak memakai login Google.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=
