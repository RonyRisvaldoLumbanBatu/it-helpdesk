{
    "name": "ronyrisvaldolumbanbatu/it-helpdesk",
    "description": "IT Helpdesk system berbasis PHP dengan UI modern, chat tiket realtime, Docker-ready, dan fitur keamanan lengkap.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "helpdesk",
        "ticketing-system",
        "it-support",
        "customer-support",
        "php",
        "mysql",
        "docker"
    ],
    "homepage": "https://github.com/RonyRisvaldoLumbanBatu/it-helpdesk",
    "support": {
        "issues": "https://github.com/RonyRisvaldoLumbanBatu/it-helpdesk/issues",
        "source": "https://github.com/RonyRisvaldoLumbanBatu/it-helpdesk"
    },
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.59"
    },
    "autoload": {
        "classmap": [
            "src/"
        ],
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "ci": [
            "@cs-check",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
